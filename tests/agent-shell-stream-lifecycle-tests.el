;;; agent-shell-stream-lifecycle-tests.el --- Stream retirement tests -*- lexical-binding: t; -*-

;;; Commentary:
;; Exercise deferred rendering without waiting for real timers or transport.

;;; Code:

(require 'ert)
(require 'cl-lib)
(require 'agent-shell)

(defun agent-shell-stream-lifecycle-tests--state ()
  "Return stream state owned by the current buffer."
  (list (cons :buffer (current-buffer))
        (cons :client (list 'client))
        (cons :session (list (cons :id "stream-lifecycle-session")))
        (cons :stream-render-timer nil)
        (cons :stream-render-pending nil)
        (cons :stream-render-generation nil)
        (cons :stream-render-client nil)
        (cons :client-maker nil)
        (cons :last-entry-type nil)
        (cons :initialized nil)
        (cons :authenticated nil)
        (cons :set-model nil)
        (cons :set-session-mode nil)
        (cons :set-config-options nil)
        (cons :init-finished nil)))

(ert-deftest agent-shell-stream-lifecycle-retire-minimal-state-test ()
  "Retiring a state without stream fields neither adds fields nor fails."
  (with-temp-buffer
    (let* ((state (list (cons :buffer (current-buffer))))
           (original (copy-tree state)))
      (agent-shell--retire-stream-render state)
      (agent-shell--retire-stream-render state)
      (should (equal state original))
      (agent-shell--retire-stream-render nil))))

(ert-deftest agent-shell-stream-lifecycle-retired-timer-cannot-flush-new-batch-test ()
  "A cancelled callback cannot flush or cancel a newer batch."
  (with-temp-buffer
    (let ((state (agent-shell-stream-lifecycle-tests--state))
          callbacks cancelled rendered)
      (cl-letf (((symbol-function 'run-at-time)
                 (lambda (_time _repeat callback)
                   (push callback callbacks)
                   callback))
                ((symbol-function 'cancel-timer)
                 (lambda (timer) (push timer cancelled)))
                ((symbol-function 'agent-shell--render-streamed-chunk)
                 (lambda (_state chunk) (push (map-elt chunk :body) rendered))))
        (agent-shell--update-streamed-fragment :state state :block-id "old" :body "old")
        (let ((old-callback (car callbacks)))
          (agent-shell--retire-stream-render state)
          (should-not (map-elt state :stream-render-pending))
          (should (memq old-callback cancelled))
          (agent-shell--update-streamed-fragment :state state :block-id "new" :body "new")
          (let ((new-callback (car callbacks)))
            (funcall old-callback)
            (should-not rendered)
            (should (eq new-callback (map-elt state :stream-render-timer)))
            (funcall new-callback)
            (should (equal rendered '("new")))
            (should-not (map-elt state :stream-render-pending))))))))

(ert-deftest agent-shell-stream-lifecycle-timer-checks-client-test ()
  "A queued callback does not render after the client changes."
  (with-temp-buffer
    (let ((state (agent-shell-stream-lifecycle-tests--state)) callback rendered)
      (cl-letf (((symbol-function 'run-at-time)
                 (lambda (_time _repeat function) (setq callback function)))
                ((symbol-function 'cancel-timer) #'ignore)
                ((symbol-function 'agent-shell--render-streamed-chunk)
                 (lambda (&rest _) (setq rendered t))))
        (agent-shell--update-streamed-fragment :state state :block-id "old" :body "old")
        (map-put! state :client (list 'replacement))
        (funcall callback)
        (should-not rendered)
        (agent-shell--retire-stream-render state)))))

(ert-deftest agent-shell-stream-lifecycle-shutdown-discards-pending-test ()
  "Shutdown discards queued text before shutting down transport."
  (with-temp-buffer
    (let ((agent-shell--state (agent-shell-stream-lifecycle-tests--state))
          callback shutdown)
      (setq major-mode 'agent-shell-mode)
      (cl-letf (((symbol-function 'run-at-time)
                 (lambda (_time _repeat function) (setq callback function)))
                ((symbol-function 'cancel-timer) #'ignore)
                ((symbol-function 'agent-shell--retire-elicitations) #'ignore)
                ((symbol-function 'agent-shell-heartbeat-stop) #'ignore)
                ((symbol-function 'acp-shutdown)
                 (lambda (&rest _)
                   (should-not (map-elt agent-shell--state :stream-render-pending))
                   (setq shutdown t)))
                ((symbol-function 'agent-shell--render-streamed-chunk)
                 (lambda (&rest _) (ert-fail "Retired text rendered"))))
        (agent-shell--update-streamed-fragment
         :state agent-shell--state :block-id "old" :body "old")
        (agent-shell--shutdown)
        (should shutdown)
        (should-not (map-elt agent-shell--state :client))
        (should-not (map-elt agent-shell--state :stream-render-timer))
        (funcall callback)))))

(ert-deftest agent-shell-stream-lifecycle-initialize-retires-old-batch-test ()
  "Creating a client retires text before bootstrapping can flush it."
  (with-temp-buffer
    (delay-mode-hooks (agent-shell-mode))
    (let* ((agent-shell--state (agent-shell-stream-lifecycle-tests--state))
           (replacement (list 'replacement)))
      (map-put! agent-shell--state :stream-render-pending '((:body . "old")))
      (map-put! agent-shell--state :client-maker (lambda (_) replacement))
      (cl-letf (((symbol-function 'agent-shell--update-bootstrapping-fragment)
                 (lambda (&rest _)
                   (should-not (map-elt agent-shell--state :stream-render-pending))))
                ((symbol-function 'agent-shell--emit-event) #'ignore))
        (should (agent-shell--initialize-client))
        (should (eq replacement (map-elt agent-shell--state :client)))))))

(ert-deftest agent-shell-stream-lifecycle-disconnect-and-replacement-test ()
  "Old disconnects and errors cannot affect a replacement client's stream."
  (with-temp-buffer
    (let ((state (agent-shell-stream-lifecycle-tests--state))
          disconnect on-error rendered)
      (cl-letf (((symbol-function 'acp-subscribe-to-disconnect)
                 (lambda (&rest args) (setq disconnect (plist-get args :on-disconnect))))
                ((symbol-function 'acp-subscribe-to-errors)
                 (lambda (&rest args) (setq on-error (plist-get args :on-error))))
                ((symbol-function 'acp-subscribe-to-notifications) #'ignore)
                ((symbol-function 'acp-subscribe-to-requests) #'ignore)
                ((symbol-function 'agent-shell--retire-elicitations) #'ignore)
                ((symbol-function 'cancel-timer) #'ignore)
                ((symbol-function 'agent-shell--update-fragment)
                 (lambda (&rest _) (setq rendered t))))
        (agent-shell--subscribe-to-client-events :state state)
        (let ((old-disconnect disconnect)
              (old-error on-error))
          (map-put! state :stream-render-pending '((:body . "old")))
          (map-put! state :stream-render-client (map-elt state :client))
          (map-put! state :client (list 'replacement))
          (agent-shell--subscribe-to-client-events :state state)
          (should-not (map-elt state :stream-render-pending))
          (let ((pending (list (cons :body "replacement"))))
            (map-put! state :stream-render-pending pending)
            (funcall old-disconnect)
            (funcall old-error '((message . "stale")))
            (should-not rendered)
            (should (eq pending (map-elt state :stream-render-pending)))
            (funcall disconnect)
            (should-not (map-elt state :stream-render-pending))))))))

(ert-deftest agent-shell-stream-lifecycle-failure-finalizes-shell-and-viewport-test ()
  "Failure flushes text before final markup in both conversation buffers."
  (with-temp-buffer
    (delay-mode-hooks (agent-shell-mode))
    (let* ((shell (current-buffer))
           (viewport (generate-new-buffer " *stream-lifecycle-viewport*"))
           (agent-shell--state (agent-shell-stream-lifecycle-tests--state))
           (agent-shell-show-busy-indicator nil)
           (render-deferred (symbol-function 'agent-shell--render-deferred-markup))
           failure events)
      (unwind-protect
          (cl-letf (((symbol-function 'agent-shell--expand-truncated-regions) #'identity)
                    ((symbol-function 'agent-shell--cancel-idle-timer) #'ignore)
                    ((symbol-function 'agent-shell--emit-event) #'ignore)
                    ((symbol-function 'agent-shell--set-session-title) #'ignore)
                    ((symbol-function 'agent-shell--append-transcript) #'ignore)
                    ((symbol-function 'agent-shell--send-request)
                     (lambda (&rest args) (setq failure (plist-get args :on-failure))))
                    ((symbol-function 'agent-shell-viewport--buffer) (lambda (&rest _) viewport))
                    ((symbol-function 'agent-shell-viewport--initialize) #'ignore)
                    ((symbol-function 'agent-shell-viewport--update-header) #'ignore)
                    ((symbol-function 'agent-shell--separate-transcript-after-agent-message) #'ignore)
                    ((symbol-function 'agent-shell--collapse-expanded-activity-group) #'ignore)
                    ((symbol-function 'agent-shell--prompt-queue-display) #'ignore)
                    ((symbol-function 'agent-shell-heartbeat-stop) #'ignore)
                    ((symbol-function 'agent-shell--make-error-handler)
                     (lambda (&rest _) (lambda (&rest _) (push 'error events))))
                    ((symbol-function 'agent-shell--flush-stream-render)
                     (lambda (_) (push 'flush events)))
                    ((symbol-function 'agent-shell--render-deferred-markup)
                     (lambda ()
                       (push (current-buffer) events)
                       (funcall render-deferred))))
            (with-current-buffer viewport
              (delay-mode-hooks (agent-shell-viewport-view-mode)))
            (agent-shell--send-command :prompt "hello" :shell-buffer shell)
            (should failure)
            (dolist (buffer (list shell viewport))
              (with-current-buffer buffer
                (let ((inhibit-read-only t))
                  (insert (propertize "Done.\n\n- Last item" 'agent-shell-ui-section 'body)))))
            (funcall failure '((message . "failed")) "raw")
            (should (equal (reverse events) (list 'flush shell 'error viewport)))
            (dolist (buffer (list shell viewport))
              (with-current-buffer buffer
                (goto-char (point-max))
                (beginning-of-line)
                (should (get-text-property (point) 'agent-shell-markdown-list-rendered))
                (should-not (looking-at-p "- ")))))
        (kill-buffer viewport)))))

(provide 'agent-shell-stream-lifecycle-tests)
;;; agent-shell-stream-lifecycle-tests.el ends here
