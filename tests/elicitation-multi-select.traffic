(((:direction . outgoing) (:kind . request)
  (:object (jsonrpc . "2.0") (method . "initialize") (id . 1)
           (params (clientInfo (name . "agent-shell")
                               (title . "Emacs Agent Shell")
                               (version . "0.73.2"))
                   (protocolVersion . 1)
                   (clientCapabilities
                    (fs (readTextFile . t)
                        (writeTextFile . t))
                    (elicitation (form))))))
 ((:direction . incoming) (:kind . response)
  (:object (jsonrpc . "2.0") (id . 1)
           (result (protocolVersion . 1)
                   (agentCapabilities
                    (loadSession . :false)
                    (promptCapabilities (image) (audio) (embeddedContext . t))))))
 ((:direction . outgoing) (:kind . request)
  (:object (jsonrpc . "2.0") (method . "session/new") (id . 2)
           (params (cwd . "/tmp") (mcpServers . []))))
 ((:direction . incoming) (:kind . response)
  (:object (jsonrpc . "2.0") (id . 2)
           (result (sessionId . "fake-session-id"))))
 ((:direction . outgoing) (:kind . request)
  (:object (jsonrpc . "2.0") (method . "session/prompt") (id . 3)
           (params (sessionId . "fake-session-id")
                   (prompt . [((type . "text")
                               (text . "Add tests to the parser"))]))))
 ((:direction . incoming) (:kind . notification)
  (:object (jsonrpc . "2.0") (method . "session/update")
           (params (sessionId . "fake-session-id")
                   (update (sessionUpdate . "agent_message_chunk")
                           (content (type . "text")
                                    (text . "Two questions before I start.\n\n"))))))
 ((:direction . incoming) (:kind . notification)
  (:object (jsonrpc . "2.0") (method . "session/update")
           (params (sessionId . "fake-session-id")
                   (update (sessionUpdate . "tool_call")
                           (toolCallId . "toolu_fake_1")
                           (title . "Two questions")
                           (status . "pending")
                           (kind . "other")))))
 ((:direction . incoming) (:kind . request)
  (:object (jsonrpc . "2.0") (id . 101) (method . "elicitation/create")
           (params (mode . "form")
                   (sessionId . "fake-session-id")
                   (toolCallId . "toolu_fake_1")
                   (message . "Two questions before I start.")
                   (requestedSchema
                    (type . "object")
                    (properties
                     (question_0
                      (type . "array")
                      (title . "Areas")
                      (description . "Which areas should the tests cover?")
                      (items (anyOf . [((const . "Parsing")
                                        (title . "Parsing")
                                        (description . "The reader itself"))
                                       ((const . "Rendering")
                                        (title . "Rendering")
                                        (description . "Output formatting"))
                                       ((const . "Errors")
                                        (title . "Errors")
                                        (description . "Malformed input"))])))
                     (question_0_custom
                      (type . "string")
                      (title . "Other")
                      (description . "Type your own answer instead of choosing an option above (optional).")
                      (_meta (_askUserQuestionCustomAnswer
                              (questionId . "question_0")
                              (isCustomAnswer . t))))
                     (question_1
                      (type . "string")
                      (title . "Runner")
                      (description . "Which test runner?")
                      (oneOf . [((const . "ert")
                                 (title . "ert")
                                 (description . "Built in"))
                                ((const . "buttercup")
                                 (title . "buttercup")
                                 (description . "BDD style"))])))))))
 ((:direction . incoming) (:kind . response)
  (:object (jsonrpc . "2.0") (id . 3)
           (result (stopReason . "end_turn")))))
