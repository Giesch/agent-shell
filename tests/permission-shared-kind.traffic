(((:direction . outgoing) (:kind . request)
  (:object (jsonrpc . "2.0") (method . "initialize") (id . 1)
           (params (clientInfo (name . "agent-shell")
                               (title . "Emacs Agent Shell")
                               (version . "0.73.2"))
                   (protocolVersion . 1)
                   (clientCapabilities
                    (fs (readTextFile . t)
                        (writeTextFile . t))
                    (elicitation (form))))))
 ((:direction . incoming) (:kind . response)
  (:object (jsonrpc . "2.0") (id . 1)
           (result (protocolVersion . 1)
                   (agentCapabilities
                    (loadSession . :false)
                    (promptCapabilities (image) (audio) (embeddedContext . t))))))
 ((:direction . outgoing) (:kind . request)
  (:object (jsonrpc . "2.0") (method . "session/new") (id . 2)
           (params (cwd . "/tmp") (mcpServers . []))))
 ((:direction . incoming) (:kind . response)
  (:object (jsonrpc . "2.0") (id . 2)
           (result (sessionId . "perm-1"))))
 ((:direction . outgoing) (:kind . request)
  (:object (jsonrpc . "2.0") (method . "session/prompt") (id . 3)
           (params (sessionId . "perm-1")
                   (prompt . [((type . "text")
                               (text . "please edit the file"))]))))
 ((:direction . incoming) (:kind . request)
  (:object (jsonrpc . "2.0") (id . 10)
           (method . "session/request_permission")
           (params
            (sessionId . "perm-1")
            (options
             . [((optionId . "auto")
                 (name . "Always allow")
                 (kind . "allow_always"))
                ((optionId . "acceptEdits")
                 (name . "Always allow edits")
                 (kind . "allow_always"))
                ((optionId . "proceed-once")
                 (name . "Allow once")
                 (kind . "allow_once"))
                ((optionId . "reject-once")
                 (name . "Reject")
                 (kind . "reject_once"))])
            (toolCall (toolCallId . "tool-call-77")
                      (status . "pending")
                      (title . "edit the file")
                      (kind . "edit")))))
 ((:direction . outgoing) (:kind . response)
  (:object (jsonrpc . "2.0") (id . 10)
           (result (outcome (outcome . "selected")
                            (optionId . "proceed-once")))))
 ((:direction . outgoing) (:kind . request)
  (:object (jsonrpc . "2.0") (method . "test/hold") (id . 98)))
 ((:direction . incoming) (:kind . notification)
  (:object (jsonrpc . "2.0") (method . "session/update")
           (params (sessionId . "perm-1")
                   (update (sessionUpdate . "tool_call_update")
                           (toolCallId . "tool-call-77")
                           (status . "completed")))))
 ((:direction . incoming) (:kind . response)
  (:object (jsonrpc . "2.0") (id . 3)
           (result (stopReason . "end_turn")))))
